# Enforce LF for all text files
* text=auto eol=lf

# Force specific file types to always use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.env text eol=lf
*.prisma text eol=lf
*.mjs text eol=lf

# Treat the following as binary (no modifications)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.webp binary
*.ico binary
*.pdf binary

# For Next.js build output
.next/** binary

# Prisma migrations
prisma/migrations/** text eol=lf

# Prevent Windows from corrupting shell scripts
*.sh text eol=lf
